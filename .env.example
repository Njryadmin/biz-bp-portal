# =============================================================================
# Biz-BP Portal — 环境变量
# =============================================================================
# 将本文件复制为 `.env` 并填写真实值。
# `docker compose up` 会自动读取 `.env`。
# =============================================================================

# --- 项目根（供引擎回调用 API） --------------------------------------------
BIZ_BP_PROJECT_ROOT=/app

# --- 服务间令牌（进程内 mock 引擎 -> API） --------------------------------
# Copilot mock 引擎运行于 API 进程内，会通过 HTTP 拉取实时数据。
# 它无法携带用户 cookie，因此使用此共享令牌鉴权。
# 生产环境请生成任意 32+ 字符的随机字符串。
BIZ_BP_SERVICE_TOKEN=internal-svc-token-CHANGE-ME-IN-PROD-32chars

# --- 内部 API 基础地址（引擎调用 API 的地址） ------------------------------
# 在 Docker 中，api 服务可通过 http://api:8000 访问
BIZ_BP_API_BASE=http://api:8000
BIZ_BP_COPILOT_HTTP_TIMEOUT=2.0

# --- 数据库 ----------------------------------------------------------------
# Postgres（供 API 的 SQLAlchemy 层 + DBT + Airflow 使用）
POSTGRES_USER=finbp
POSTGRES_PASSWORD=finbp
POSTGRES_DB=finbp
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
BIZ_BP_DATABASE_URL=postgresql+asyncpg://finbp:finbp@postgres:5432/finbp

# ClickHouse（分析型数据库，可选）
CLICKHOUSE_USER=finbp
CLICKHOUSE_PASSWORD=finbp
CLICKHOUSE_DB=finbp

# Redis（缓存 / 队列，可选）
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO（用于原始上传的 S3 兼容文件存储）
MINIO_ROOT_USER=finbp
MINIO_ROOT_PASSWORD=finbp12345
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001

# --- Airflow ----------------------------------------------------------------
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://finbp:finbp@postgres:5432/finbp
AIRFLOW__CORE__FERNET_KEY=ZmRidmZ4amJ4c2t0dmZ4amJ4c2t0dmZ4amJ4c2t0dmY=
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=True
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# dbt 连接（与 infra/dbt/profiles.yml 一致）
DBT_HOST=postgres
DBT_PORT=5432
DBT_USER=finbp
DBT_PASSWORD=finbp
DBT_DBNAME=finbp

# --- AI Copilot LLM（可插拔后端） -----------------------------------------
# 三个变量全部留空 → 回退到内置规则引擎（MockBackend）。
#
# 1) DeepSeek（国内推荐；最便宜，OpenAI 兼容）：
#    在 https://platform.deepseek.com/ 申请 key
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=30
DEEPSEEK_TEMPERATURE=0.3
#
# 2) Ollama（完全本地；从 https://ollama.com/ 安装）：
#    设置 OLLAMA_BASE_URL 和 OLLAMA_MODEL，并将 DEEPSEEK_API_KEY 留空。
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=30
#
# 注：工厂优先级为 DEEPSEEK_API_KEY > OLLAMA_BASE_URL > MockBackend。
# 若 DeepSeek 调用失败（网络/401 等），Copilot 会自动回退到 Mock，
# 并在响应中标记 `used_fallback: true`。

# --- 前端 → 后端连接 --------------------------------------------------------
# /api/* 下的 BFF 代理会转发到 NEXT_PUBLIC_API_BASE_URL。
# 在 Docker 中，Next.js 容器通过 http://api:8000 访问 API 服务
NEXT_PUBLIC_API_BASE_URL=http://api:8000

# --- 公共主机名（可选） ----------------------------------------------------
# 当门户部署在域名 / 反向代理之后时设置
PUBLIC_HOSTNAME=http://localhost

# --- 日志 -------------------------------------------------------------------
LOG_LEVEL=info

# --- 身份认证 / RBAC --------------------------------------------------------
# HS256 JWT 签名密钥。生产环境必须至少 32 字符。
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-32-chars-min-please
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# 引导 admin 账号（首次启动时，若 `users` 表为空则自动创建）。
# 任何非开发环境请务必修改密码。
BIZ_BP_BOOTSTRAP_ADMIN_USERNAME=admin
BIZ_BP_BOOTSTRAP_ADMIN_PASSWORD=admin123

# 引导所有 BP 业务线用户的统一初始密码（9 个 bp-* 账号）。
# 与 admin 不同 — BP 用户通常不希望共享同一个密码 —
# 首次登录后请强制各用户重置。
BIZ_BP_BOOTSTRAP_BP_PASSWORD=bp123456

# Cookie 加固。生产环境请设为 `true`（仅 HTTPS）。
BIZ_BP_COOKIE_SECURE=false

# Cookie 名称。仅在当前环境存在冲突时才需要修改。
BIZ_BP_COOKIE_NAME=finbp_token

# --- AI 模型注册表密钥 ------------------------------------------------------
# 可选的 Fernet 密钥（32 字节 URL 安全 base64），用于静态加密
# ``ai_models.api_key``。生成方法::
#
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# 开发环境可留空——辅助函数会回退到明文（每次启动会打印 WARNING）。
# 生产环境请设置此值，避免数据库 dump 泄露 LLM 厂商密钥。
BIZ_BP_AI_SECRET_KEY=


# =============================================================================
# Biz-BP Portal — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in real values.
# `docker compose up` reads from `.env` automatically.
# =============================================================================

# --- Project root (used by engines to call back to API) ----------------------
BIZ_BP_PROJECT_ROOT=/app

# --- Service-to-service token (in-process mock engine -> API) ---------------
# The Copilot mock engine runs INSIDE the API process and makes HTTP
# calls to fetch live data. It cannot carry a user's cookie, so it
# authenticates with this shared token. Generate any random 32+ char
# string in production.
BIZ_BP_SERVICE_TOKEN=internal-svc-token-CHANGE-ME-IN-PROD-32chars

# --- Internal API base (how engines talk to the API) -------------------------
# In Docker, the api service is reachable at http://api:8000
BIZ_BP_API_BASE=http://api:8000
BIZ_BP_COPILOT_HTTP_TIMEOUT=2.0

# --- Database ----------------------------------------------------------------
# Postgres (used by the API SQLAlchemy layer + DBT + Airflow)
POSTGRES_USER=finbp
POSTGRES_PASSWORD=finbp
POSTGRES_DB=finbp
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
BIZ_BP_DATABASE_URL=postgresql+asyncpg://finbp:finbp@postgres:5432/finbp

# ClickHouse (analytics, optional)
CLICKHOUSE_USER=finbp
CLICKHOUSE_PASSWORD=finbp
CLICKHOUSE_DB=finbp

# Redis (cache / queue, optional)
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO (S3-compatible file storage for raw uploads)
MINIO_ROOT_USER=finbp
MINIO_ROOT_PASSWORD=finbp12345
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001

# --- Airflow -----------------------------------------------------------------
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://finbp:finbp@postgres:5432/finbp
AIRFLOW__CORE__FERNET_KEY=ZmRidmZ4amJ4c2t0dmZ4amJ4c2t0dmZ4amJ4c2t0dmY=
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=True
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# dbt connection (matches infra/dbt/profiles.yml)
DBT_HOST=postgres
DBT_PORT=5432
DBT_USER=finbp
DBT_PASSWORD=finbp
DBT_DBNAME=finbp

# --- AI Copilot LLM (pluggable backend) -------------------------------------
# Leave all three empty → falls back to the built-in rule engine (MockBackend).
#
# 1) DeepSeek (recommended for China; cheapest, OpenAI-compatible):
#    Get a key at https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=30
DEEPSEEK_TEMPERATURE=0.3
#
# 2) Ollama (fully local; install from https://ollama.com/):
#    Set OLLAMA_BASE_URL and OLLAMA_MODEL, leave DEEPSEEK_API_KEY empty.
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=30
#
# Note: factory precedence is DEEPSEEK_API_KEY > OLLAMA_BASE_URL > MockBackend.
# If DeepSeek call fails (network/401/etc), Copilot auto-falls-back to Mock
# and sets `used_fallback: true` on the response.

# --- Frontend → Backend wiring -----------------------------------------------
# The BFF proxies under /api/* forward to NEXT_PUBLIC_API_BASE_URL.
# In Docker, Next.js container reaches the API service at http://api:8000
NEXT_PUBLIC_API_BASE_URL=http://api:8000

# --- Public hostname (optional) ----------------------------------------------
# Set if you put the portal behind a domain / reverse proxy
PUBLIC_HOSTNAME=http://localhost

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=info

# --- Authentication / RBAC ---------------------------------------------------
# HS256 JWT signing secret. MUST be at least 32 characters in production.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-32-chars-min-please
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# Bootstrap admin (auto-created on first boot if `users` table is empty).
# CHANGE THE PASSWORD in any non-dev environment.
BIZ_BP_BOOTSTRAP_ADMIN_USERNAME=admin
BIZ_BP_BOOTSTRAP_ADMIN_PASSWORD=admin123

# Cookie hardening. Set to `true` in production (HTTPS only).
BIZ_BP_COOKIE_SECURE=false

# Cookie name. Override only if you have a collision in your environment.
BIZ_BP_COOKIE_NAME=finbp_token

# --- AI-model registry secret -----------------------------------------------
# Optional Fernet key (32 URL-safe base64 bytes) used to encrypt
# ``ai_models.api_key`` at rest. Generate with::
#
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Leave empty in dev — the helper will fall back to plaintext (with a
# WARNING on every boot). Set this in production so a DB dump doesn't
# leak LLM provider keys.
BIZ_BP_AI_SECRET_KEY=


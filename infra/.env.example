# infra/.env.example
# 复制为 .env 并按需调整。

POSTGRES_USER=finbp
POSTGRES_PASSWORD=finbp
POSTGRES_DB=finbp
POSTGRES_PORT=5432

REDIS_PORT=6379

CLICKHOUSE_USER=finbp
CLICKHOUSE_PASSWORD=finbp
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9100

MINIO_ROOT_USER=finbp
MINIO_ROOT_PASSWORD=finbp12345
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# ─────────────────────────────────────────────────────────────────────────
# Biz-BP Portal 应用层环境变量
# ─────────────────────────────────────────────────────────────────────────
# 这些是 FastAPI 容器读取的变量。docker-compose.yml 都给了默认值，
# 这里列出只是便于统一管理。覆盖后请重启 `api` 服务。
#
# 引导账号（首次启动时自动创建 — 见 apps/api/app/db/seed_users.py）
BIZ_BP_BOOTSTRAP_ADMIN_USERNAME=admin
BIZ_BP_BOOTSTRAP_ADMIN_PASSWORD=admin123
BIZ_BP_BOOTSTRAP_BP_PASSWORD=bp123456
#
# Cookie
BIZ_BP_COOKIE_NAME=finbp_token
BIZ_BP_COOKIE_SECURE=false
#
# 进程内 mock 引擎调用 API 的服务间令牌
BIZ_BP_SERVICE_TOKEN=internal-svc-token-CHANGE-ME-IN-PROD
#
# Fernet 加密 ai_models.api_key 列的密钥
# 不设则 api_key 明文存储；生产必须设置
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# BIZ_BP_AI_SECRET_KEY=
#
# JWT 签名密钥
JWT_SECRET=change-me-in-production-32-chars-min-please
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ─────────────────────────────────────────────────────────────────────────
# AI Copilot LLM 配置
# ─────────────────────────────────────────────────────────────────────────
# 取消注释以下其中一个区块即可启用真实 LLM 后端。
# 全部留空时，Copilot 以 mock 模式运行（对已注册业务线 API
# 使用规则引擎，无任何网络调用）。
#
# 同时设置多个时优先级：DEEPSEEK_API_KEY > OLLAMA_BASE_URL > mock。
# 当真实 LLM 调用失败（超时 / 4xx / 5xx / 网络异常）时，Copilot
# 会自动回退到 mock 后端，并在响应中标记 `used_fallback: true`。
# 不会向用户返回 500。
#
# --- DeepSeek（国内性价比最高，推荐）---
# 在 https://platform.deepseek.com/ 申请 key
# 默认模型：deepseek-chat（V3）。默认端点：https://api.deepseek.com/v1/chat/completions
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
# DEEPSEEK_TIMEOUT=30
# DEEPSEEK_TEMPERATURE=0.3
#
# --- Ollama（本地 / 私有部署）---
# 先运行 `ollama serve`，再 `ollama pull qwen2.5:7b`（或其他模型）。
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_TIMEOUT=30


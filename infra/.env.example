# infra/.env.example
# Copy to .env and adjust as needed.

POSTGRES_USER=finbp
POSTGRES_PASSWORD=finbp
POSTGRES_DB=finbp
POSTGRES_PORT=5432

REDIS_PORT=6379

CLICKHOUSE_USER=finbp
CLICKHOUSE_PASSWORD=finbp
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9100

MINIO_ROOT_USER=finbp
MINIO_ROOT_PASSWORD=finbp12345
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# ─────────────────────────────────────────────────────────────────────────
# AI Copilot LLM Configuration
# ─────────────────────────────────────────────────────────────────────────
# Uncomment exactly ONE of the following sections to enable a real LLM
# backend. If none are set, the Copilot runs in mock mode (rule engine
# over the registered business-line APIs, no network calls).
#
# Priority when multiple are set: DEEPSEEK_API_KEY > OLLAMA_BASE_URL > mock.
# When a real LLM fails (timeout / 4xx / 5xx / network), the Copilot
# AUTOMATICALLY falls back to the mock backend and marks the response
# with `used_fallback: true`. No 500s to the user.
#
# --- DeepSeek (国内性价比最高,推荐) ---
# Get a key at https://platform.deepseek.com/
# Default model: deepseek-chat (V3). Default endpoint: https://api.deepseek.com/v1/chat/completions
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
# DEEPSEEK_TIMEOUT=30
# DEEPSEEK_TEMPERATURE=0.3
#
# --- Ollama (本地/私有部署) ---
# Run `ollama serve` then `ollama pull qwen2.5:7b` (or any other model).
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_TIMEOUT=30

